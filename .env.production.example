# ── PostgreSQL propio (al_lio_postgres) ──────────────────────────────────────
# La aplicación usa exclusivamente el rol limitado al_lio_app.
DATABASE_URL=postgresql://al_lio_app:REPLACE_ME@al_lio_postgres:5432/al_lio
# Solo para tareas puntuales de migración/administración. Esta variable no se
# inyecta en el contenedor web normal.
DATABASE_MIGRATION_URL=postgresql://al_lio:REPLACE_ME@al_lio_postgres:5432/al_lio
POSTGRES_PASSWORD=REPLACE_ME

# ── Sesión propia ─────────────────────────────────────────────────────────────
# Clave para firmar la cookie de sesión. Genera una con: openssl rand -hex 32
SESSION_SECRET=REPLACE_ME

# Mismo valor en al_lio_web y al_lio_radar. Generar con: openssl rand -hex 32
AL_LIO_RADAR_WEBHOOK_SECRET=REPLACE_ME
# Leave empty until the coordinated Radar v4 rollout is explicitly approved.
AL_LIO_RADAR_V4_PROJECT_DESTINATIONS=
# Dormant Radar controls. The reviewed news pilot is activated separately after
# this release is healthy; see docs/operations/OPENWEBINARS_NEWS_PILOT.md.
AL_LIO_RADAR_DELIVERY_SCHEMA_VERSION=3
AL_LIO_RADAR_AUTONOMOUS_PUBLICATION_ENABLED=false
AL_LIO_RADAR_AUTONOMOUS_PUBLICATION_DESTINATIONS=news
AL_LIO_RADAR_AUTONOMOUS_NEWS_SOURCE_CYCLE_MATRIX_JSON={}
AL_LIO_RADAR_DAILY_PUBLICATION_TIMEZONE=Europe/Madrid
AL_LIO_RADAR_DAILY_PUBLICATION_TIME=09:00
AL_LIO_RADAR_WEB_DISCOVERY_ENABLED=false
AL_LIO_RADAR_LEARNING_DISCOVERY_ENABLED=false
AL_LIO_RADAR_YOUTUBE_WATCH_ENABLED=false
AL_LIO_RADAR_LEARNING_DELIVERY_ENABLED=false
# Optional secret. Configure only through the private production .env after a
# reviewed YouTube source/cycle pilot has been approved.
AL_LIO_RADAR_YOUTUBE_API_KEY=
AL_LIO_RADAR_JOB_RADAR_ENABLED=false

# ── App ───────────────────────────────────────────────────────────────────────
TARGET_USER_EMAIL=REPLACE_ME@example.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# Un solo cliente, dos redirect URIs autorizados: identidad (login, sin
# scope de Calendar) y Calendar (consentimiento aparte, ya autenticado).
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_IDENTITY_REDIRECT_URI=https://al-lio.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://al-lio.app/api/google/calendar/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_ME

# ── Correo transaccional (Resend) ───────────────────────────────────────────
# Confirmación de registro, recuperación de contraseña.
RESEND_API_KEY=REPLACE_ME
RESEND_FROM_EMAIL=REPLACE_ME

# ── URLs de producción ────────────────────────────────────────────────────────
BASE_URL=https://al-lio.app

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Managed automatically in each immutable release .env. Do not hand-edit this
# value or add AL_LIO_RELEASE_SHA to this template; prepare-release-env.sh
# injects both from the exact worktree commit.
AL_LIO_IMAGE_TAG=REPLACE_WITH_GIT_SHA
AL_LIO_RADAR_IMAGE_TAG=REPLACE_WITH_RADAR_GIT_SHA
# Ruta del repo al-lio-radar vista desde infra/docker-compose.prod.yml.
AL_LIO_RADAR_BUILD_CONTEXT=../../al-lio-radar

# PostgreSQL runtime
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
